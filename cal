<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MG 맞춤형 대출 상환 계산기 | 새마을금고</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            mg: {
              blue: '#004b92',       // 새마을금고 시그니처 딥블루
              dark: '#002f5d',       // 다크 블루
              light: '#e8f1f8',      // 소프트 배경 블루
              accent: '#0085d0',     // 액센트 스카이블루
              cyan: '#00a0d2',       // 하이라이트 시안
              gold: '#e69818',       // 포인트 골드
            }
          }
        }
      }
    }
  </script>
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Pretendard Font -->
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
  <style>
    body {
      font-family: "Pretendard Variable", Pretendard, -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
    }
    /* 커스텀 스크롤바 */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    /* 인쇄 전용 스타일 */
    @media print {
      body {
        background-color: white !important;
        color: black !important;
      }
      .no-print {
        display: none !important;
      }
      .print-only {
        display: block !important;
      }
      .card-box {
        box-shadow: none !important;
        border: 1px solid #ddd !important;
      }
      .schedule-container {
        max-height: none !important;
        overflow: visible !important;
      }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col antialiased">

  <!-- 상단 GNB / 헤더 -->
  <header class="bg-mg-dark text-white border-b border-mg-blue shadow-md sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <!-- MG 심볼릭 아이콘 -->
        <div class="w-10 h-10 rounded-lg bg-white flex items-center justify-center shadow-inner">
          <span class="font-extrabold text-mg-blue text-lg tracking-tighter">MG</span>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <span class="font-bold text-lg sm:text-xl tracking-tight">새마을금고</span>
            <span class="text-xs font-semibold px-2 py-0.5 rounded bg-mg-accent text-white uppercase tracking-wider">상담 지원</span>
          </div>
          <p class="text-[11px] text-blue-200 hidden sm:block">스마트 금융파트너 MG 맞춤형 여신 솔루션</p>
        </div>
      </div>
      <div class="flex items-center space-x-2">
        <button onclick="window.print()" class="no-print inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-md bg-white/10 hover:bg-white/20 text-white transition border border-white/20">
          <i class="fa-solid fa-print mr-1.5"></i> 상담결과 인쇄
        </button>
      </div>
    </div>
  </header>

  <!-- 메인 컨테이너 -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    <!-- 인쇄용 워터마크/헤더 (인쇄 시에만 표시) -->
    <div class="hidden print-only mb-6 pb-4 border-b-2 border-mg-blue">
      <div class="flex justify-between items-end">
        <div>
          <h1 class="text-2xl font-bold text-mg-blue">MG새마을금고 대출 상환 플랜 안내서</h1>
          <p class="text-sm text-gray-500 mt-1">고객님의 든든한 금융 동반자, 새마을금고가 맞춤형 상환 계획을 안내해 드립니다.</p>
        </div>
        <div class="text-right text-xs text-gray-400">
          <p id="printDate"></p>
          <p>창구 상담용 시뮬레이션 결과</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
      
      <!-- ================= 1. 입력 패널 (좌측) ================= -->
      <section class="lg:col-span-5 bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 sm:p-6 card-box">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-5">
          <div class="flex items-center space-x-2">
            <div class="w-2.5 h-6 bg-mg-blue rounded-full"></div>
            <h2 class="text-lg font-bold text-slate-800">대출 조건 설정</h2>
          </div>
          <button type="button" onclick="resetForm()" class="text-xs text-slate-400 hover:text-slate-600 flex items-center transition">
            <i class="fa-solid fa-rotate-right mr-1"></i> 초기화
          </button>
        </div>

        <form id="loanForm" onsubmit="event.preventDefault(); calculateLoan();" class="space-y-5">
          <!-- 1) 대출 금액 -->
          <div>
            <div class="flex justify-between items-baseline mb-1.5">
              <label for="loanAmount" class="block text-sm font-semibold text-slate-700">
                대출 희망 금액
              </label>
              <span id="amountKorean" class="text-xs font-medium text-mg-accent tracking-tight">5,000만 원</span>
            </div>
            <div class="relative rounded-xl shadow-sm">
              <input 
                type="text" 
                id="loanAmount" 
                class="block w-full rounded-xl border border-slate-300 pl-4 pr-14 py-3 text-slate-900 font-bold text-lg text-right focus:border-mg-blue focus:ring-2 focus:ring-mg-blue/20 outline-none transition"
                value="5,000"
                placeholder="0"
                oninput="handleAmountInput(this)"
              />
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4">
                <span class="text-sm font-semibold text-slate-500">만원</span>
              </div>
            </div>
            <!-- 금액 빠른 추가 버튼 -->
            <div class="flex flex-wrap gap-1.5 mt-2.5">
              <button type="button" onclick="addAmount(100)" class="px-2.5 py-1 text-xs font-medium rounded-lg bg-slate-100 hover:bg-mg-light hover:text-mg-blue text-slate-600 transition border border-slate-200/60">+100만</button>
              <button type="button" onclick="addAmount(500)" class="px-2.5 py-1 text-xs font-medium rounded-lg bg-slate-100 hover:bg-mg-light hover:text-mg-blue text-slate-600 transition border border-slate-200/60">+500만</button>
              <button type="button" onclick="addAmount(1000)" class="px-2.5 py-1 text-xs font-medium rounded-lg bg-slate-100 hover:bg-mg-light hover:text-mg-blue text-slate-600 transition border border-slate-200/60">+1,000만</button>
              <button type="button" onclick="addAmount(5000)" class="px-2.5 py-1 text-xs font-medium rounded-lg bg-slate-100 hover:bg-mg-light hover:text-mg-blue text-slate-600 transition border border-slate-200/60">+5,000만</button>
              <button type="button" onclick="setAmount(10000)" class="px-2.5 py-1 text-xs font-medium rounded-lg bg-slate-100 hover:bg-mg-light hover:text-mg-blue text-slate-600 transition border border-slate-200/60">1억</button>
            </div>
          </div>

          <!-- 2) 대출 기간 -->
          <div>
            <div class="flex justify-between items-baseline mb-1.5">
              <label for="loanTerm" class="block text-sm font-semibold text-slate-700">대출 기간</label>
              <!-- 기간 단위 토글 (개월 / 년) -->
              <div class="inline-flex rounded-lg p-0.5 bg-slate-100 border border-slate-200 text-xs">
                <button type="button" id="unitMonthBtn" onclick="setTermUnit('month')" class="px-2 py-0.5 rounded-md font-medium bg-white text-mg-blue shadow-sm">개월</button>
                <button type="button" id="unitYearBtn" onclick="setTermUnit('year')" class="px-2 py-0.5 rounded-md font-medium text-slate-500 hover:text-slate-800">년</button>
              </div>
            </div>
            <div class="relative rounded-xl shadow-sm">
              <input 
                type="number" 
                id="loanTerm" 
                class="block w-full rounded-xl border border-slate-300 pl-4 pr-14 py-3 text-slate-900 font-bold text-lg text-right focus:border-mg-blue focus:ring-2 focus:ring-mg-blue/20 outline-none transition"
                value="24"
                min="1"
                max="600"
                oninput="updateTermDisplay()"
              />
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4">
                <span id="termUnitText" class="text-sm font-semibold text-slate-500">개월</span>
              </div>
            </div>
            <!-- 기간 빠른 선택 버튼 -->
            <div class="flex flex-wrap gap-1.5 mt-2.5" id="termQuickBtns">
              <!-- JS에서 단위에 따라 버튼 동적 생성 -->
            </div>
          </div>

          <!-- 3) 연 이자율 -->
          <div>
            <div class="flex justify-between items-baseline mb-1.5">
              <label for="interestRate" class="block text-sm font-semibold text-slate-700">연 이자율</label>
              <span class="text-xs text-slate-400 font-normal">법정최고금리 연 20% 이내</span>
            </div>
            <div class="relative rounded-xl shadow-sm">
              <input 
                type="number" 
                id="interestRate" 
                step="0.01" 
                min="0.1" 
                max="20.0" 
                class="block w-full rounded-xl border border-slate-300 pl-4 pr-14 py-3 text-slate-900 font-bold text-lg text-right focus:border-mg-blue focus:ring-2 focus:ring-mg-blue/20 outline-none transition"
                value="4.50"
                oninput="calculateLoan()"
              />
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4">
                <span class="text-sm font-semibold text-slate-500">%</span>
              </div>
            </div>
            <!-- 이율 빠른 가감 버튼 -->
            <div class="flex gap-1.5 mt-2.5">
              <button type="button" onclick="adjustRate(-0.5)" class="flex-1 py-1 text-xs font-medium rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition">-0.5%</button>
              <button type="button" onclick="adjustRate(-0.1)" class="flex-1 py-1 text-xs font-medium rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition">-0.1%</button>
              <button type="button" onclick="adjustRate(0.1)" class="flex-1 py-1 text-xs font-medium rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition">+0.1%</button>
              <button type="button" onclick="adjustRate(0.5)" class="flex-1 py-1 text-xs font-medium rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition">+0.5%</button>
            </div>
          </div>

          <!-- 4) 상환 방식 선택 -->
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">상환 방식</label>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
              <!-- 원리금균등 -->
              <label class="relative flex flex-col p-3 border rounded-xl cursor-pointer text-center select-none transition border-mg-blue bg-mg-light/50" id="methodLabel-equal-pi">
                <input type="radio" name="repayMethod" value="equal-pi" class="sr-only" checked onchange="handleMethodChange(this)">
                <span class="text-xs font-bold text-mg-blue mb-1" id="methodTitle-equal-pi">원리금균등</span>
                <span class="text-[11px] text-slate-500 leading-tight">매달 원금+이자 동일 금액 납부</span>
              </label>

              <!-- 원금균등 -->
              <label class="relative flex flex-col p-3 border rounded-xl cursor-pointer text-center select-none transition border-slate-200 bg-white hover:border-slate-300" id="methodLabel-equal-p">
                <input type="radio" name="repayMethod" value="equal-p" class="sr-only" onchange="handleMethodChange(this)">
                <span class="text-xs font-bold text-slate-700 mb-1" id="methodTitle-equal-p">원금균등</span>
                <span class="text-[11px] text-slate-500 leading-tight">매달 원금 고정 납입금 점차 감소</span>
              </label>

              <!-- 만기일시 -->
              <label class="relative flex flex-col p-3 border rounded-xl cursor-pointer text-center select-none transition border-slate-200 bg-white hover:border-slate-300" id="methodLabel-maturity">
                <input type="radio" name="repayMethod" value="maturity" class="sr-only" onchange="handleMethodChange(this)">
                <span class="text-xs font-bold text-slate-700 mb-1" id="methodTitle-maturity">만기일시</span>
                <span class="text-[11px] text-slate-500 leading-tight">매달 이자만, 만기에 원금 전액</span>
              </label>
            </div>
          </div>

          <!-- 5) 거치 기간 옵션 (접기/펼치기) -->
          <div class="pt-1">
            <button type="button" onclick="toggleGracePeriod()" class="text-xs font-medium text-slate-500 hover:text-mg-accent flex items-center transition">
              <i class="fa-solid fa-chevron-right text-[10px] mr-1.5 transition-transform" id="graceArrow"></i>
              거치 기간(이자만 납부하는 기간) 추가 설정
            </button>
            <div id="graceContainer" class="hidden mt-3 p-3 bg-slate-50 rounded-xl border border-slate-200/80">
              <div class="flex justify-between items-center mb-1">
                <label for="gracePeriod" class="text-xs font-semibold text-slate-600">거치 기간 (개월)</label>
                <span class="text-xs font-bold text-mg-blue" id="graceDisplay">0개월</span>
              </div>
              <input 
                type="range" 
                id="gracePeriod" 
                min="0" 
                max="60" 
                value="0" 
                class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-mg-blue"
                oninput="handleGraceChange(this.value)"
              />
              <p class="text-[11px] text-slate-400 mt-1">* 거치 기간 동안에는 이자만 납부하며 이후 남은 기간 동안 원금을 분할 상환합니다.</p>
            </div>
          </div>

          <!-- 계산 실행 버튼 -->
          <div class="pt-2">
            <button 
              type="submit" 
              class="w-full py-3.5 px-4 rounded-xl bg-mg-blue hover:bg-mg-dark text-white font-bold text-base shadow-md shadow-mg-blue/25 hover:shadow-lg transition flex items-center justify-center space-x-2"
            >
              <i class="fa-solid fa-calculator"></i>
              <span>상환 계획 계산하기</span>
            </button>
          </div>
        </form>
      </section>

      <!-- ================= 2. 결과 출력 패널 (우측) ================= -->
      <section class="lg:col-span-7 space-y-6">
        
        <!-- 요약 카드 -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 sm:p-6 card-box">
          <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div class="flex items-center space-x-2">
              <div class="w-2.5 h-6 bg-mg-accent rounded-full"></div>
              <h2 class="text-lg font-bold text-slate-800">대출 상환 요약</h2>
            </div>
            <span id="selectedMethodBadge" class="px-2.5 py-1 text-xs font-semibold rounded-full bg-mg-light text-mg-blue border border-mg-blue/20">
              원리금균등분할상환
            </span>
          </div>

          <!-- 핵심 숫자 그리드 -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-5">
            <!-- 1회차 상환액 -->
            <div class="bg-gradient-to-br from-mg-light to-white p-4 sm:p-5 rounded-xl border border-blue-100 relative overflow-hidden">
              <div class="text-xs font-semibold text-mg-blue tracking-tight flex items-center">
                <i class="fa-solid fa-calendar-day mr-1.5"></i> 1회차 상환액
              </div>
              <div class="mt-2 flex items-baseline">
                <span class="text-2xl sm:text-3xl font-extrabold text-mg-dark tracking-tight" id="firstMonthPayment">0</span>
                <span class="ml-1 text-sm font-semibold text-slate-600">원</span>
              </div>
              <p class="text-[11px] text-slate-500 mt-1" id="firstMonthDetail">원금 0원 + 이자 0원</p>
              <div class="absolute -right-3 -bottom-3 text-mg-blue/10 text-6xl pointer-events-none">
                <i class="fa-solid fa-coins"></i>
              </div>
            </div>

            <!-- 총 대출 이자 -->
            <div class="bg-slate-50 p-4 sm:p-5 rounded-xl border border-slate-200 relative overflow-hidden">
              <div class="text-xs font-semibold text-slate-600 tracking-tight flex items-center">
                <i class="fa-solid fa-percent mr-1.5 text-amber-500"></i> 총 대출 이자
              </div>
              <div class="mt-2 flex items-baseline">
                <span class="text-2xl sm:text-3xl font-extrabold text-amber-600 tracking-tight" id="totalInterest">0</span>
                <span class="ml-1 text-sm font-semibold text-slate-600">원</span>
              </div>
              <p class="text-[11px] text-slate-400 mt-1" id="interestRatioText">대출원금의 약 0%</p>
              <div class="absolute -right-3 -bottom-3 text-amber-500/10 text-6xl pointer-events-none">
                <i class="fa-solid fa-chart-pie"></i>
              </div>
            </div>
          </div>

          <!-- 총 상환액 & 원금 비중 바 -->
          <div class="bg-slate-50/70 p-4 rounded-xl border border-slate-100">
            <div class="flex justify-between items-center text-xs text-slate-600 mb-2">
              <span class="font-medium">총 상환금액 (원금 + 총이자)</span>
              <span class="font-bold text-sm text-slate-900" id="totalRepayment">0 원</span>
            </div>
            
            <!-- 시각화 프로그레스 바 -->
            <div class="w-full h-3 bg-slate-200 rounded-full overflow-hidden flex">
              <div id="principalBar" class="bg-mg-blue h-full transition-all duration-500" style="width: 80%" title="원금"></div>
              <div id="interestBar" class="bg-amber-400 h-full transition-all duration-500" style="width: 20%" title="이자"></div>
            </div>
            
            <div class="flex justify-between text-[11px] text-slate-500 mt-2 font-medium">
              <div class="flex items-center">
                <span class="w-2.5 h-2.5 rounded-full bg-mg-blue inline-block mr-1"></span>
                원금 <span id="principalPortion" class="ml-1 font-semibold text-slate-700">0원</span>
              </div>
              <div class="flex items-center">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400 inline-block mr-1"></span>
                총이자 <span id="interestPortion" class="ml-1 font-semibold text-amber-600">0원</span>
              </div>
            </div>
          </div>
        </div>

        <!-- ================= 3. 상세 상환 스케줄 표 ================= -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 sm:p-6 card-box">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-3">
            <div>
              <h3 class="text-base font-bold text-slate-800 flex items-center">
                <i class="fa-solid fa-list-ol text-mg-blue mr-2"></i> 회차별 상환 스케줄
              </h3>
              <p class="text-xs text-slate-400 mt-0.5" id="scheduleSubInfo">총 0회차 계획표</p>
            </div>
            
            <!-- 액션 버튼 -->
            <div class="flex items-center space-x-2 no-print">
              <button 
                type="button" 
                onclick="downloadCSV()" 
                class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition flex items-center border border-slate-200"
              >
                <i class="fa-solid fa-file-excel text-emerald-600 mr-1.5"></i> 엑셀(CSV) 저장
              </button>
              <button 
                type="button" 
                id="toggleViewBtn" 
                onclick="toggleScheduleView()" 
                class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-mg-light hover:bg-blue-100 text-mg-blue transition border border-mg-blue/20"
              >
                전체 펼치기
              </button>
            </div>
          </div>

          <!-- 테이블 래퍼 -->
          <div class="overflow-x-auto mt-4 schedule-container max-h-96 transition-all" id="scheduleTableWrapper">
            <table class="w-full text-left border-collapse text-xs">
              <thead class="bg-slate-100/90 text-slate-600 font-semibold sticky top-0 z-10">
                <tr>
                  <th class="py-2.5 px-3 text-center rounded-l-lg">회차</th>
                  <th class="py-2.5 px-3 text-right">월 납입금</th>
                  <th class="py-2.5 px-3 text-right">납입 원금</th>
                  <th class="py-2.5 px-3 text-right">이자</th>
                  <th class="py-2.5 px-3 text-right rounded-r-lg">대출 잔액</th>
                </tr>
              </thead>
              <tbody id="scheduleTableBody" class="divide-y divide-slate-100 text-slate-700">
                <!-- Javascript로 동적 렌더링 -->
              </tbody>
            </table>
          </div>

          <!-- 주의사항 안내 -->
          <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-400 space-y-1">
            <p>※ 본 시뮬레이션 결과는 고객님의 이해를 돕기 위한 예시 계산으로, 실제 대출 실행일, 금리 변동 주기, 일할 계산 및 세부 금고 여신 규정에 따라 실제 청구 금액과 다소 차이가 발생할 수 있습니다.</p>
            <p>※ 대출 관련 세부 사항 및 우대금리 요건은 가까운 새마을금고 영업점 창구로 문의하여 주시기 바랍니다.</p>
          </div>
        </div>

      </section>
    </div>
  </main>

  <!-- 푸터 -->
  <footer class="bg-slate-100 border-t border-slate-200 mt-12 py-6 text-slate-500 text-xs text-center no-print">
    <div class="max-w-7xl mx-auto px-4">
      <p class="font-semibold text-slate-700">MG새마을금고 금융소비자보호 안내</p>
      <p class="mt-1">여신심사 규정에 따라 대출 가능 여부 및 적용 금리가 변동될 수 있습니다. 상환능력에 비해 대출금이 과도할 경우 신용평점이 하락할 수 있습니다.</p>
      <p class="text-[11px] text-slate-400 mt-2">© MG Community Credit Cooperatives. All rights reserved.</p>
    </div>
  </footer>

  <!-- 토스트 알림 컴포넌트 (alert() 대체) -->
  <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-slate-900 text-white text-xs px-4 py-3 rounded-xl shadow-xl flex items-center space-x-2">
    <i class="fa-solid fa-circle-check text-emerald-400 text-sm"></i>
    <span id="toastMsg">알림 메시지</span>
  </div>

  <!-- ================= JavaScript 로직 ================= -->
  <script>
    // 전역 상태 변수
    let termUnit = 'month'; // 'month' or 'year'
    let isScheduleExpanded = false;
    let currentScheduleData = [];

    // 숫자 천단위 포맷 함수
    function formatNumber(num) {
      if (isNaN(num) || num === null || num === undefined) return "0";
      return Math.round(num).toLocaleString('ko-KR');
    }

    // 만원 단위를 한글 표기로 변환 (예: 5000 -> 5,000만 원 (5천만 원))
    function convertToKoreanAmount(manWon) {
      if (!manWon || manWon <= 0) return '0원';
      const won = manWon * 10000;
      
      const eok = Math.floor(won / 100000000);
      const man = Math.floor((won % 100000000) / 10000);
      
      let result = '';
      if (eok > 0) {
        result += `${formatNumber(eok)}억 `;
      }
      if (man > 0) {
        result += `${formatNumber(man)}만 `;
      }
      return `${result.trim()}원`;
    }

    // 토스트 알림창
    function showToast(msg) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMsg');
      toastMsg.innerText = msg;
      toast.classList.remove('translate-y-20', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 2500);
    }

    // 금액 인풋 핸들러
    function handleAmountInput(input) {
      let val = input.value.replace(/[^0-9]/g, '');
      if (val === '') {
        input.value = '';
        document.getElementById('amountKorean').innerText = '0원';
        return;
      }
      let num = parseInt(val, 10);
      input.value = num.toLocaleString('ko-KR');
      document.getElementById('amountKorean').innerText = convertToKoreanAmount(num);
      calculateLoan();
    }

    // 금액 버튼 가산
    function addAmount(addManWon) {
      const input = document.getElementById('loanAmount');
      let current = parseInt(input.value.replace(/[^0-9]/g, ''), 10) || 0;
      let next = current + addManWon;
      input.value = next.toLocaleString('ko-KR');
      document.getElementById('amountKorean').innerText = convertToKoreanAmount(next);
      calculateLoan();
    }

    // 특정 금액 직접 세팅
    function setAmount(manWon) {
      const input = document.getElementById('loanAmount');
      input.value = manWon.toLocaleString('ko-KR');
      document.getElementById('amountKorean').innerText = convertToKoreanAmount(manWon);
      calculateLoan();
    }

    // 기간 단위 토글 (개월 <-> 년)
    function setTermUnit(unit) {
      if (termUnit === unit) return;
      const termInput = document.getElementById('loanTerm');
      let val = parseInt(termInput.value, 10) || 12;
      
      termUnit = unit;
      const mBtn = document.getElementById('unitMonthBtn');
      const yBtn = document.getElementById('unitYearBtn');
      const unitText = document.getElementById('termUnitText');

      if (unit === 'month') {
        mBtn.className = "px-2 py-0.5 rounded-md font-medium bg-white text-mg-blue shadow-sm";
        yBtn.className = "px-2 py-0.5 rounded-md font-medium text-slate-500 hover:text-slate-800";
        unitText.innerText = "개월";
        termInput.value = val * 12;
      } else {
        yBtn.className = "px-2 py-0.5 rounded-md font-medium bg-white text-mg-blue shadow-sm";
        mBtn.className = "px-2 py-0.5 rounded-md font-medium text-slate-500 hover:text-slate-800";
        unitText.innerText = "년";
        termInput.value = Math.max(1, Math.round(val / 12));
      }
      renderTermQuickButtons();
      calculateLoan();
    }

    // 기간 퀵 버튼 렌더링
    function renderTermQuickButtons() {
      const container = document.getElementById('termQuickBtns');
      container.innerHTML = '';
      const list = termUnit === 'month' 
        ? [{ label: '12개월', val: 12 }, { label: '24개월', val: 24 }, { label: '36개월', val: 36 }, { label: '60개월', val: 60 }, { label: '120개월', val: 120 }]
        : [{ label: '1년', val: 1 }, { label: '2년', val: 2 }, { label: '3년', val: 3 }, { label: '5년', val: 5 }, { label: '10년', val: 10 }, { label: '20년', val: 20 }];

      list.forEach(item => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = "px-2.5 py-1 text-xs font-medium rounded-lg bg-slate-100 hover:bg-mg-light hover:text-mg-blue text-slate-600 transition border border-slate-200/60";
        btn.innerText = item.label;
        btn.onclick = () => {
          document.getElementById('loanTerm').value = item.val;
          calculateLoan();
        };
        container.appendChild(btn);
      });
    }

    function updateTermDisplay() {
      calculateLoan();
    }

    // 금리 미세 조정
    function adjustRate(delta) {
      const rateInput = document.getElementById('interestRate');
      let current = parseFloat(rateInput.value) || 0;
      let next = Math.max(0.1, Math.min(20.0, current + delta));
      rateInput.value = next.toFixed(2);
      calculateLoan();
    }

    // 상환방식 라디오 버튼 스타일 토글
    function handleMethodChange(radio) {
      const methods = ['equal-pi', 'equal-p', 'maturity'];
      methods.forEach(m => {
        const lbl = document.getElementById(`methodLabel-${m}`);
        const title = document.getElementById(`methodTitle-${m}`);
        if (m === radio.value) {
          lbl.className = "relative flex flex-col p-3 border rounded-xl cursor-pointer text-center select-none transition border-mg-blue bg-mg-light/50";
          title.className = "text-xs font-bold text-mg-blue mb-1";
        } else {
          lbl.className = "relative flex flex-col p-3 border rounded-xl cursor-pointer text-center select-none transition border-slate-200 bg-white hover:border-slate-300";
          title.className = "text-xs font-bold text-slate-700 mb-1";
        }
      });

      // 뱃지 업데이트
      const badge = document.getElementById('selectedMethodBadge');
      if (radio.value === 'equal-pi') badge.innerText = '원리금균등분할상환';
      else if (radio.value === 'equal-p') badge.innerText = '원금균등분할상환';
      else badge.innerText = '만기일시상환';

      calculateLoan();
    }

    // 거치기간 패널 아코디언 토글
    function toggleGracePeriod() {
      const c = document.getElementById('graceContainer');
      const arrow = document.getElementById('graceArrow');
      if (c.classList.contains('hidden')) {
        c.classList.remove('hidden');
        arrow.style.transform = 'rotate(90deg)';
      } else {
        c.classList.add('hidden');
        arrow.style.transform = 'rotate(0deg)';
      }
    }

    function handleGraceChange(val) {
      document.getElementById('graceDisplay').innerText = `${val}개월`;
      calculateLoan();
    }

    // 폼 초기화
    function resetForm() {
      document.getElementById('loanAmount').value = '5,000';
      document.getElementById('amountKorean').innerText = '5,000만 원';
      document.getElementById('loanTerm').value = termUnit === 'month' ? '24' : '2';
      document.getElementById('interestRate').value = '4.50';
      document.querySelector('input[name="repayMethod"][value="equal-pi"]').checked = true;
      handleMethodChange({ value: 'equal-pi' });
      document.getElementById('gracePeriod').value = 0;
      document.getElementById('graceDisplay').innerText = '0개월';
      calculateLoan();
      showToast('입력값이 기본값으로 초기화되었습니다.');
    }

    // 스케줄 테이블 접기/펼치기
    function toggleScheduleView() {
      const wrapper = document.getElementById('scheduleTableWrapper');
      const btn = document.getElementById('toggleViewBtn');
      isScheduleExpanded = !isScheduleExpanded;

      if (isScheduleExpanded) {
        wrapper.classList.remove('max-h-96');
        btn.innerText = '접기';
      } else {
        wrapper.classList.add('max-h-96');
        btn.innerText = '전체 펼치기';
      }
    }

    // ================= 핵심 대출 계산 로직 =================
    function calculateLoan() {
      const amountVal = document.getElementById('loanAmount').value.replace(/[^0-9]/g, '');
      const principal = (parseInt(amountVal, 10) || 0) * 10000; // 원 단위 변환
      let termCount = parseInt(document.getElementById('loanTerm').value, 10) || 0;
      if (termUnit === 'year') {
        termCount = termCount * 12;
      }
      
      const annualRate = parseFloat(document.getElementById('interestRate').value) || 0;
      const method = document.querySelector('input[name="repayMethod"]:checked').value;
      const graceMonths = parseInt(document.getElementById('gracePeriod').value, 10) || 0;

      // 예외 조건 처리
      if (principal <= 0 || termCount <= 0 || annualRate < 0) {
        renderEmptyResults();
        return;
      }

      // 유효성: 거치 기간이 총 대출기간보다 길거나 같은 경우 보정
      let validGrace = graceMonths;
      if (method !== 'maturity' && validGrace >= termCount) {
        validGrace = Math.max(0, termCount - 1);
        document.getElementById('gracePeriod').value = validGrace;
        document.getElementById('graceDisplay').innerText = `${validGrace}개월`;
      }

      const monthlyRate = (annualRate / 100) / 12;
      let schedule = [];
      let balance = principal;
      let totalInterest = 0;
      let firstMonthRepayment = 0;
      let firstMonthPrincipal = 0;
      let firstMonthInterest = 0;

      // 1. 원리금균등분할상환
      if (method === 'equal-pi') {
        const repayMonths = termCount - validGrace;
        let monthlyPMT = 0;
        
        if (monthlyRate === 0) {
          monthlyPMT = repayMonths > 0 ? (principal / repayMonths) : 0;
        } else if (repayMonths > 0) {
          monthlyPMT = (principal * monthlyRate * Math.pow(1 + monthlyRate, repayMonths)) / (Math.pow(1 + monthlyRate, repayMonths) - 1);
        }

        for (let m = 1; m <= termCount; m++) {
          const interest = Math.round(balance * monthlyRate);
          let paidPrincipal = 0;
          let payment = 0;

          if (m <= validGrace) {
            // 거치 기간: 이자만 납부
            paidPrincipal = 0;
            payment = interest;
          } else {
            // 원리금 상환 기간
            if (m === termCount) {
              // 마지막 회차 오차 보정
              paidPrincipal = balance;
              payment = paidPrincipal + interest;
              balance = 0;
            } else {
              paidPrincipal = Math.round(monthlyPMT - interest);
              if (paidPrincipal > balance) paidPrincipal = balance;
              payment = paidPrincipal + interest;
              balance -= paidPrincipal;
            }
          }

          if (m === 1) {
            firstMonthRepayment = payment;
            firstMonthPrincipal = paidPrincipal;
            firstMonthInterest = interest;
          }

          totalInterest += interest;
          schedule.push({
            month: m,
            payment: payment,
            principal: paidPrincipal,
            interest: interest,
            balance: Math.max(0, balance)
          });
        }
      }
      // 2. 원금균등분할상환
      else if (method === 'equal-p') {
        const repayMonths = termCount - validGrace;
        const fixedPrincipal = repayMonths > 0 ? Math.floor(principal / repayMonths) : 0;

        for (let m = 1; m <= termCount; m++) {
          const interest = Math.round(balance * monthlyRate);
          let paidPrincipal = 0;
          let payment = 0;

          if (m <= validGrace) {
            // 거치 기간
            paidPrincipal = 0;
            payment = interest;
          } else {
            if (m === termCount) {
              paidPrincipal = balance; // 잔여 전액
              balance = 0;
            } else {
              paidPrincipal = fixedPrincipal;
              balance -= paidPrincipal;
            }
            payment = paidPrincipal + interest;
          }

          if (m === 1) {
            firstMonthRepayment = payment;
            firstMonthPrincipal = paidPrincipal;
            firstMonthInterest = interest;
          }

          totalInterest += interest;
          schedule.push({
            month: m,
            payment: payment,
            principal: paidPrincipal,
            interest: interest,
            balance: Math.max(0, balance)
          });
        }
      }
      // 3. 만기일시상환
      else if (method === 'maturity') {
        const monthlyInterest = Math.round(principal * monthlyRate);

        for (let m = 1; m <= termCount; m++) {
          let paidPrincipal = 0;
          let interest = monthlyInterest;
          let payment = 0;

          if (m === termCount) {
            paidPrincipal = principal;
            balance = 0;
          }
          payment = paidPrincipal + interest;

          if (m === 1) {
            firstMonthRepayment = payment;
            firstMonthPrincipal = paidPrincipal;
            firstMonthInterest = interest;
          }

          totalInterest += interest;
          schedule.push({
            month: m,
            payment: payment,
            principal: paidPrincipal,
            interest: interest,
            balance: Math.max(0, balance)
          });
        }
      }

      currentScheduleData = schedule;
      updateUIResults(principal, totalInterest, firstMonthRepayment, firstMonthPrincipal, firstMonthInterest, schedule, termCount);
    }

    // 결과 렌더링
    function updateUIResults(principal, totalInterest, firstPayment, firstPrincipal, firstInterest, schedule, termCount) {
      const totalRepay = principal + totalInterest;
      
      document.getElementById('firstMonthPayment').innerText = formatNumber(firstPayment);
      document.getElementById('firstMonthDetail').innerText = `원금 ${formatNumber(firstPrincipal)}원 + 이자 ${formatNumber(firstInterest)}원`;
      
      document.getElementById('totalInterest').innerText = formatNumber(totalInterest);
      const ratio = principal > 0 ? ((totalInterest / principal) * 100).toFixed(1) : 0;
      document.getElementById('interestRatioText').innerText = `대출원금의 약 ${ratio}% 수준`;
      
      document.getElementById('totalRepayment').innerText = `${formatNumber(totalRepay)} 원`;
      document.getElementById('principalPortion').innerText = `${formatNumber(principal)}원`;
      document.getElementById('interestPortion').innerText = `${formatNumber(totalInterest)}원`;

      // 프로그레스 바 비율
      const pPercent = totalRepay > 0 ? (principal / totalRepay) * 100 : 100;
      const iPercent = 100 - pPercent;
      document.getElementById('principalBar').style.width = `${pPercent}%`;
      document.getElementById('interestBar').style.width = `${iPercent}%`;

      document.getElementById('scheduleSubInfo').innerText = `총 ${termCount}회차 계획표 (원금 ${formatNumber(principal)}원 기준)`;

      // 테이블 렌더링
      const tbody = document.getElementById('scheduleTableBody');
      tbody.innerHTML = '';

      schedule.forEach((row, idx) => {
        const tr = document.createElement('tr');
        tr.className = (idx % 2 === 0 ? 'bg-white' : 'bg-slate-50/60') + " hover:bg-blue-50/50 transition";

        tr.innerHTML = `
          <td class="py-2.5 px-3 text-center font-medium text-slate-500">${row.month}회차</td>
          <td class="py-2.5 px-3 text-right font-bold text-slate-900">${formatNumber(row.payment)}원</td>
          <td class="py-2.5 px-3 text-right text-slate-700">${formatNumber(row.principal)}원</td>
          <td class="py-2.5 px-3 text-right text-amber-600 font-medium">${formatNumber(row.interest)}원</td>
          <td class="py-2.5 px-3 text-right text-slate-500">${formatNumber(row.balance)}원</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function renderEmptyResults() {
      document.getElementById('firstMonthPayment').innerText = "0";
      document.getElementById('firstMonthDetail').innerText = "원금 0원 + 이자 0원";
      document.getElementById('totalInterest').innerText = "0";
      document.getElementById('interestRatioText').innerText = "대출원금의 0%";
      document.getElementById('totalRepayment').innerText = "0 원";
      document.getElementById('scheduleTableBody').innerHTML = '<tr><td colspan="5" class="py-8 text-center text-slate-400">조건을 올바르게 입력하시면 상환 스케줄이 계산됩니다.</td></tr>';
    }

    // CSV 파일 다운로드 기능
    function downloadCSV() {
      if (!currentScheduleData || currentScheduleData.length === 0) {
        showToast('내보낼 상환 스케줄이 없습니다.');
        return;
      }

      let csv = "\uFEFF회차,월납입금(원),납입원금(원),이자(원),대출잔액(원)\n";
      currentScheduleData.forEach(row => {
        csv += `${row.month},${row.payment},${row.principal},${row.interest},${row.balance}\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      const url = URL.createObjectURL(blob);
      link.setAttribute('href', url);
      link.setAttribute('download', `MG_대출상환스케줄_${new Date().toISOString().slice(0,10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast('엑셀(CSV) 파일로 저장되었습니다.');
    }

    // 페이지 로드 시 초기화
    window.onload = function() {
      renderTermQuickButtons();
      calculateLoan();

      // 인쇄 날짜 표시
      const today = new Date();
      const dateStr = `${today.getFullYear()}년 ${today.getMonth()+1}월 ${today.getDate()}일`;
      const pDate = document.getElementById('printDate');
      if (pDate) pDate.innerText = `출력일자: ${dateStr}`;
    };
  </script>
